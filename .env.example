# Copy this file to .env and set values locally. Do not commit .env.
DATABASE_PASSWORD=
SUPABASE_URL=
SUPABASE_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=

# Frontend (exposed to the browser bundle by Vite — safe, RLS-protected public keys only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: school location for weather, heat index, and earthquakes (defaults to Manila)
VITE_SCHOOL_LAT=
VITE_SCHOOL_LON=
VITE_SCHOOL_PLACE=

# Server-side only (used by scripts/seed-sample-accounts.mjs) — NEVER prefix with VITE_, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
